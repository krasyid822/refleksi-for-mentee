# ============================================================
# Override konfigurasi untuk pengembangan LOKAL
#
# Salin file ini menjadi .env.local lalu sesuaikan:
#   cp .env.local.example .env.local
#
# Nilai di .env.local MENIMPA nilai di .env, tetapi file ini:
#   - tidak di-commit ke Git (.gitignore)
#   - tidak diunggah ke server FTP (.git-ftp-ignore)
# ============================================================

# ---------- Database lokal (MySQL/MariaDB) ----------
# Dipakai saat menjalankan ./run.sh di komputer sendiri.
# DB InfinityFree hanya bisa diakses dari hostingnya, jadi di lokal
# kita memakai database lokal.
DB_SERVER=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=refleksi_local

# Jika MySQL lokal memakai port lain, tulis host:port, mis.:
# DB_SERVER=127.0.0.1:3307

# ---------- Opsional: override API key saat development ----------
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
