# ============================================================
# Contoh konfigurasi environment - Refleksi for Mentee
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# ---------- Zona waktu ----------
# Dipakai PHP dan sesi MySQL agar waktu & zona selalu sinkron.
APP_TIMEZONE=Asia/Jakarta

# ---------- Database (MySQL/MariaDB) ----------
# Ganti "HOSTNAME-SERVER-HERE" menjadi "localhost" atau host server Anda.
DB_SERVER=HOSTNAME-SERVER-HERE
DB_USERNAME=USERNAME-DATABASE-HERE
DB_PASSWORD=DATABASE-PASSWORD-HERE
DB_NAME=DATABASE-NAME-HERE

# ---------- Gemini AI ----------
# Dapatkan API key di https://aistudio.google.com
GEMINI_API_KEY=GEMINI-API-KEY-HERE
GEMINI_MODEL=gemini-1.5-flash-latest

# ---------- OpenRouter (server-side) ----------
# Dapatkan API key di https://openrouter.ai/keys
# Kunci ini TIDAK pernah dikirim ke browser; semua panggilan lewat ai_proxy.php.
OPENROUTER_API_KEY=OPENROUTER-API-KEY-HERE
# Opsional: model gratis yang diprioritaskan (harus berakhiran :free).
OPENROUTER_MODEL=
# Opsional: identitas aplikasi untuk header OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Refleksi Mentee

# ---------- GitHub issue (untuk skema tabel baru) ----------
# Token perlu izin "Issues: Write" pada repo tujuan.
# Nama lama GITHUB_FINEGRAINED_TOKEN juga didukung.
GITHUB_TOKEN=
GITHUB_REPO=krasyid822/refleksi-for-mentee

# ---------- Refresh cache kata-kata ----------
# Token opsional untuk memaksa refresh kata-kata.json lewat web.
KATA_KATA_REFRESH_TOKEN=

# ---------- Enkripsi konfigurasi server ----------
# Jalankan ./let-encrypt.sh sebelum push FTP. Skrip itu membuat .env.enc
# (AES-256-GCM) dan memasang kunci numeric ke env.php.
# File .env asli tetap lokal dan tidak diunggah ke FTP.

# ---------- Deployment via git-ftp ----------
# Digunakan oleh push.sh (git ftp push) dan pull.sh (lftp).
# Contoh URL: ftp://ftpupload.net/refleksiformentee.xo.je/htdocs/
FTP_URL=FTP-URL-HERE
FTP_USER=FTP-USERNAME-HERE
FTP_PASSWORD=FTP-PASSWORD-HERE
# Sub-folder tujuan jika bukan root (opsional). Kosongkan bila tak perlu.
FTP_SYNCROOT=
