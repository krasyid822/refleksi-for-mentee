# ============================================================
# Contoh konfigurasi environment - Refleksi for Mentee
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# ---------- Database (MySQL/MariaDB) ----------
# Ganti "HOSTNAME-SERVER-HERE" menjadi "localhost" atau host server Anda.
DB_SERVER=HOSTNAME-SERVER-HERE
DB_USERNAME=USERNAME-DATABASE-HERE
DB_PASSWORD=DATABASE-PASSWORD-HERE
DB_NAME=DATABASE-NAME-HERE

# ---------- Gemini AI ----------
# Dapatkan API key di https://aistudio.google.com
GEMINI_API_KEY=GEMINI-API-KEY-HERE
GEMINI_MODEL=gemini-1.5-flash-latest

# ---------- OpenRouter (fitur form psikologi) ----------
# Dapatkan API key di https://openrouter.ai/keys
OPENROUTER_API_KEY=OPENROUTER-API-KEY-HERE

# ---------- Deployment via git-ftp ----------
# Digunakan oleh push.sh (git ftp push) dan pull.sh (lftp).
# Contoh URL: ftp://ftpupload.net/refleksiformentee.xo.je/htdocs/
FTP_URL=FTP-URL-HERE
FTP_USER=FTP-USERNAME-HERE
FTP_PASSWORD=FTP-PASSWORD-HERE
# Sub-folder tujuan jika bukan root (opsional). Kosongkan bila tak perlu.
FTP_SYNCROOT=
