{
  "mcp": {
    "servers": {
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.5.0",
          "mcp"
        ],
        "environment": {
          "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath=/usr/bin/brave",
          "--isolated"
        ]
      },
      "lighthouse": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@danielsogl/lighthouse-mcp@latest",
          "--chrome-path",
          "/usr/bin/brave"
        ]
      }
    }
  }
}